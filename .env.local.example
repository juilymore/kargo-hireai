SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Advanced-reasoning preview model, chosen for rubric-following quality over
# speed. Swap to a stable model string here if the preview becomes unsuitable
# for production (check https://ai.google.dev/gemini-api/docs/models first —
# model names change).
GEMINI_MODEL=gemini-3.1-pro-preview
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Any URL you want candidates to click to book time — Google Calendar
# scheduling link, Calendly, etc. Just dropped verbatim into the email body.
SCHEDULING_LINK=
# Optional. Prefills the email-preview modal's recipient field whenever a
# candidate has no email on file — handy for testing/demoing without typing
# an address every time. Leave blank in a real deployment.
DEFAULT_TEST_EMAIL=
